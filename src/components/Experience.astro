---
import ExperienceItem from './ExperienceItem.astro';

const EXPERIENCIE = [
	{
		date: 'January 2024 - Currently...',
		title: 'Full Stack Developer - Freelancer',
		description:
			'I dedicate myself to creating customized technological solutions for individual clients and companies, managing complete projects from planning and architecture design to the implementation of functionalities on both the front-end and back-end. Throughout this time, I have worked on projects such as advanced Discord bot systems, content management applications and monetization platforms. My solutions are characterized by their efficiency, security and scalability, always aligned with the client\'s business objectives.'
	}
];
---

<ol class="relative mt-16">
	{
		EXPERIENCIE.map((experiencie) => (
			<li class="">
				<ExperienceItem {...experiencie} />
			</li>
		))
	}
</ol>
